diff --git a/bsp/abstract-machine/extra_soc.ld b/bsp/abstract-machine/extra_soc.ld
new file mode 100644
index 000000000..57b2b51f2
--- /dev/null
+++ b/bsp/abstract-machine/extra_soc.ld
@@ -0,0 +1,47 @@
+SECTIONS {
+  .data.extra : {
+    /* section information for finsh shell */
+    __fsymtab_start = .;
+    KEEP(*(FSymTab))
+    __fsymtab_end = .;
+    . = ALIGN(8);
+    __vsymtab_start = .;
+    KEEP(*(VSymTab))
+    __vsymtab_end = .;
+    . = ALIGN(8);
+
+    /* section information for initial. */
+    . = ALIGN(8);
+    __rt_init_start = .;
+    KEEP(*(SORT(.rti_fn*)))
+    __rt_init_end = .;
+    . = ALIGN(8);
+
+    __rt_utest_tc_tab_start = .;
+    KEEP(*(UtestTcTab))
+    __rt_utest_tc_tab_end = .;
+
+    . = ALIGN(8);
+    __am_apps_data_start = .;
+    *(__am_apps.data*)
+    *(__am_apps.sdata*)
+    __am_apps_data_end = .;
+    . = ALIGN(8);
+  } >SDRAM AT> FLASH
+  _data_end = .;
+}
+/* INSERT BEFORE .data; */
+INSERT AFTER .data;
+SECTIONS {
+  .bss.extra : {
+    . = ALIGN(8);
+    __am_apps_bss_start = .;
+    *(__am_apps.bss*)
+    *(__am_apps.sbss*)
+    *(__am_apps.scommon*)
+    __am_apps_bss_end = .;
+    . = ALIGN(8);
+  } >SDRAM AT> FLASH
+}
+/* INSERT BEFORE .bss; */
+INSERT AFTER .bss;
diff --git a/bsp/abstract-machine/src/context.c b/bsp/abstract-machine/src/context.c
index ee38829ae..aa84b114b 100644
--- a/bsp/abstract-machine/src/context.c
+++ b/bsp/abstract-machine/src/context.c
@@ -2,30 +2,91 @@
 #include <klib.h>
 #include <rtthread.h>
 
-static Context* ev_handler(Event e, Context *c) {
+//线程上下文切换
+typedef struct {
+  rt_ubase_t to;
+  rt_ubase_t from;
+} ctx_switch_ud_t;
+
+//线程入口
+typedef struct {
+  void (*tentry)(void*);
+  void* parameter;
+  void (*texit)(void);
+} thread_args_t;
+
+//线程启动
+static void context_wrapper(thread_args_t* args) {
+  args->tentry(args->parameter);
+  args->texit();
+  while (1);  // 不应返回
+}
+
+//事件处理
+static Context* ev_handler(Event e, Context* c) {
   switch (e.event) {
-    default: printf("Unhandled event ID = %d\n", e.event); assert(0);
+    case EVENT_YIELD: {
+      rt_thread_t current = rt_thread_self();
+      ctx_switch_ud_t *ud = (ctx_switch_ud_t *)current->user_data;
+      if (ud->from) *((Context**)ud->from) = c;
+      c = *(Context**)ud->to;
+      break;
+    }
+    case EVENT_IRQ_TIMER:
+      return c;
+    case EVENT_IRQ_IODEV:
+      return c;
+    default:
+      printf("Unhandled event ID = %d\n", e.event);
+      assert(0);
   }
   return c;
 }
 
+//初始化
 void __am_cte_init() {
   cte_init(ev_handler);
 }
 
+//线程切换
 void rt_hw_context_switch_to(rt_ubase_t to) {
-  assert(0);
+  rt_thread_t current = rt_thread_self();
+  ctx_switch_ud_t ud;
+  ud.to   = to;
+  ud.from = 0;
+  rt_ubase_t old_ud = current->user_data;
+  current->user_data = (rt_ubase_t)&ud;
+  yield();
+  current->user_data = old_ud;
 }
 
+//线程上下文切换
 void rt_hw_context_switch(rt_ubase_t from, rt_ubase_t to) {
-  assert(0);
+  rt_thread_t current = rt_thread_self();
+  ctx_switch_ud_t ud;
+  ud.to   = to;
+  ud.from = from;
+  rt_ubase_t old_ud = current->user_data;
+  current->user_data = (rt_ubase_t)&ud;
+  yield();
+  current->user_data = old_ud;
 }
 
+//
 void rt_hw_context_switch_interrupt(void *context, rt_ubase_t from, rt_ubase_t to, struct rt_thread *to_thread) {
   assert(0);
 }
 
-rt_uint8_t *rt_hw_stack_init(void *tentry, void *parameter, rt_uint8_t *stack_addr, void *texit) {
-  assert(0);
-  return NULL;
-}
+//线程初始化
+rt_uint8_t* rt_hw_stack_init(void* tentry, void* parameter, rt_uint8_t* stack_addr, void* texit) {
+  stack_addr = (rt_uint8_t*)(((uintptr_t)stack_addr + sizeof(uintptr_t) - 1) & ~(sizeof(uintptr_t) - 1));
+  stack_addr -= sizeof(thread_args_t); // 在栈上分配参数结构体空间
+  thread_args_t* args = (thread_args_t*)stack_addr; // 转型
+  // 设置参数
+  args->tentry = (void (*)(void*))tentry;
+  args->parameter = parameter;
+  args->texit = (void (*)(void))texit;
+  Area stack_area = {.end = (rt_uint8_t*)stack_addr};  // 设置栈区域
+  rt_uint8_t* c = (rt_uint8_t*)kcontext(stack_area, (void*)context_wrapper, args);
+  return c;
+}
\ No newline at end of file
